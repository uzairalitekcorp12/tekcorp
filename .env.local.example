# Production / real data:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/tekcorp

# Development only. When true, MongoDB is skipped completely.
USE_LOCAL_DATA=false

# Development only. Defaults to true outside production.
# When MongoDB fails locally, demo content can keep UI work moving.
ALLOW_LOCAL_DATA_FALLBACK=true

# Used by Article share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
