# Required in production for insights, case studies, and contact submissions.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

# Local development only. Never enable this on a live deployment because
# contact submissions must use durable MongoDB persistence in production.
USE_LOCAL_DATA=false
ALLOW_LOCAL_DATA_FALLBACK=true

# Used when generating article share URLs in the browser.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional Google Business Profile reviews integration.
GOOGLE_REVIEWS_ENABLED=false
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_REVIEW_ID_1=
GOOGLE_REVIEW_ID_2=
GOOGLE_REVIEW_ID_3=
